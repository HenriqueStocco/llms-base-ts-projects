#!/usr/bin/env bash
# commit-msg hook: validates the subject line against Conventional Commits 1.0.0.
#
# Usage (called by Git): commit-msg <message-file>
#
# To adopt a different project convention, edit ALLOWED_TYPES or the pattern below.
set -euo pipefail

ALLOWED_TYPES="build chore ci docs feat fix perf refactor revert style test"

# Prefixes generated by Git itself; they are not validated.
is_generated_subject() {
  case "$1" in
    "Merge "* | 'Revert "'* | 'Reapply "'* | "fixup! "* | "squash! "* | "amend! "*)
      return 0
      ;;
  esac
  return 1
}

# Prints the first line that is neither blank nor a comment (nothing if none).
read_subject() {
  local file="$1"
  local line

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"

    if [[ -z "${line//[[:space:]]/}" ]]; then
      continue
    fi

    if [[ "$line" == \#* ]]; then
      continue
    fi

    printf '%s\n' "$line"
    return 0
  done < "$file"

  return 0
}

fail() {
  local subject="$1"

  {
    echo "commit-msg: invalid commit message."
    echo "  subject:  ${subject:-<empty>}"
    echo "  expected: <type>(<scope>): <description>"
    echo "            scope is optional; '!' before ':' marks a breaking change"
    echo "  types:    ${ALLOWED_TYPES}"
    echo "If this project uses a different convention, edit ALLOWED_TYPES or the"
    echo "pattern in this script (.githooks/commit-msg)."
  } >&2
  exit 1
}

main() {
  if [[ $# -lt 1 || ! -f "$1" ]]; then
    echo "commit-msg: expected the commit message file as the first argument." >&2
    exit 1
  fi

  local subject
  subject="$(read_subject "$1")"

  if [[ -z "$subject" ]]; then
    fail ""
  fi

  if is_generated_subject "$subject"; then
    exit 0
  fi

  local types_pattern="${ALLOWED_TYPES// /|}"
  local pattern="^(${types_pattern})(\\([^()[:space:]]+\\))?!?: .*[^[:space:]]\$"

  if [[ "$subject" =~ $pattern ]]; then
    exit 0
  fi

  fail "$subject"
}

main "$@"
