#!/usr/bin/env bash
# pre-push hook: runs the project's `verify` script before pushing.
# The project defines `verify` in package.json (e.g. typecheck + lint + tests);
# this hook does not invent any other script.
#
# Supports Bun and pnpm only. The package manager comes from the "packageManager"
# field in package.json (bun@ or pnpm@), then from the lockfile.
set -euo pipefail

# Succeeds when package.json has a "verify" entry inside its "scripts" block.
# Text-based on purpose (no jq); it assumes the usual pretty-printed layout.
has_verify_script() {
  local scripts_block

  if [[ ! -f package.json ]]; then
    return 1
  fi

  scripts_block="$(sed -n '/"scripts"[[:space:]]*:/,/^[[:space:]]*},\{0,1\}[[:space:]]*$/p' package.json)"

  grep -q '"verify"[[:space:]]*:' <<< "$scripts_block"
}

# Prints the value of the "packageManager" field (nothing if absent).
# Text-based on purpose (no jq); handles pretty-printed and minified JSON.
read_package_manager_field() {
  local output
  output="$(sed -n 's/.*"packageManager"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' package.json)"

  printf '%s\n' "${output%%$'\n'*}"
}

# Prints "bun", "pnpm" or "unsupported" (nothing if no package manager is found).
# Order: the "packageManager" field first, then the lockfile.
detect_package_manager() {
  local field
  field="$(read_package_manager_field)"

  case "$field" in
    bun@*)
      echo "bun"
      return 0
      ;;
    pnpm@*)
      echo "pnpm"
      return 0
      ;;
    "") ;;
    *)
      echo "unsupported"
      return 0
      ;;
  esac

  if [[ -f bun.lock || -f bun.lockb ]]; then
    echo "bun"
  elif [[ -f pnpm-lock.yaml ]]; then
    echo "pnpm"
  elif [[ -f package-lock.json || -f npm-shrinkwrap.json || -f yarn.lock ]]; then
    echo "unsupported"
  fi
}

main() {
  local root
  if ! root="$(git rev-parse --show-toplevel)"; then
    echo "pre-push: not inside a Git work tree." >&2
    exit 1
  fi

  cd "$root"

  if ! has_verify_script; then
    echo "pre-push: no \"verify\" script in package.json, skipped" >&2
    exit 0
  fi

  local manager
  manager="$(detect_package_manager)"

  if [[ "$manager" == "unsupported" ]]; then
    echo "pre-push: unsupported package manager (this kit supports Bun and pnpm)." >&2
    echo "Found npm or Yarn in the \"packageManager\" field or as the lockfile." >&2
    exit 1
  fi

  if [[ -z "$manager" ]]; then
    echo "pre-push: package.json has a \"verify\" script but no package manager was detected" >&2
    echo "(\"packageManager\" bun@ or pnpm@ in package.json, or bun.lock, bun.lockb," >&2
    echo "pnpm-lock.yaml). Refusing to push without verification." >&2
    exit 1
  fi

  if ! command -v "$manager" > /dev/null 2>&1; then
    echo "pre-push: '$manager' (from package.json or the lockfile) was not found in PATH." >&2
    exit 1
  fi

  exec "$manager" run verify
}

main "$@"
